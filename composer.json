{
    "name": "mahdyaralipor/parsidate",
    "description": "A modern, zero-dependency PHP library for Jalali (Shamsi) date and time — with holidays, periods, and Persian digit support.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "jalali", "shamsi", "persian", "date", "datetime",
        "calendar", "iran", "holiday", "تاریخ", "جلالی", "شمسی"
    ],
    "authors": [
        {
            "name": "Mahdyaralipor",
            "homepage": "https://github.com/Mahdyaralipor",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/Mahdyaralipor/parsidate",
    "support": {
        "issues": "https://github.com/Mahdyaralipor/parsidate/issues",
        "source": "https://github.com/Mahdyaralipor/parsidate"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ParsiDate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParsiDate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit tests/",
        "test:coverage": "./vendor/bin/phpunit tests/ --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}