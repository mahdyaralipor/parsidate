{
    "name": "mahdyaralipor/parsidate",
    "description": "A modern, zero-dependency PHP library for Jalali (Shamsi) date and time.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "jalali",
        "shamsi",
        "persian",
        "date",
        "calender",
        "iran",
        "time"
    ],
    "authors": [
        {
            "name": "Mahdyaralipor",
            "homepage": "https://github.com/Mahdyaralipor"
        }
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "ParsiDate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ParsiDate\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}